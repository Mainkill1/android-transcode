{
  "schemaVersion": 1,
  "kind": "planned-image-test-manifest",
  "implemented": false,
  "allSelectionRunOn": [
    "android",
    "native"
  ],
  "cases": [
    {
      "id": "geometry_identity",
      "runOn": "native",
      "features": [
        "GEO-06",
        "META-04"
      ],
      "expectedOutcome": "success",
      "oracle": [
        "Identity PNG preserves decoded pixels."
      ]
    },
    {
      "id": "orientation_all_eight",
      "runOn": "native",
      "features": [
        "SRC-07",
        "GEO-03",
        "GEO-04"
      ],
      "expectedOutcome": "success",
      "oracle": [
        "All eight orientations match independently labeled corner fixtures exactly once."
      ]
    },
    {
      "id": "geometry_crop_turn_resize",
      "runOn": "native",
      "features": [
        "GEO-01",
        "GEO-03",
        "GEO-06"
      ],
      "expectedOutcome": "success",
      "oracle": [
        "1200x800 crop 0.25,0.25,0.75,0.75 then clockwise quarter turn and longest edge 300 produces 200x300."
      ]
    },
    {
      "id": "geometry_odd_png",
      "runOn": "native",
      "features": [
        "GEO-06",
        "EXP-05"
      ],
      "expectedOutcome": "success",
