<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="${applicationId}.READ_MEDIA" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.READ_MEDIA" />
    <application>
        <provider android:name="dev.forma.app.WritableImageExportTestProvider"
            android:authorities="${applicationId}.writable-image-export"
            android:exported="true" android:grantUriPermissions="true" />
        <!-- Only serves generated test tones; never exposes user files. -->
        <provider android:name="dev.forma.app.SharedMediaTestProvider"
            android:authorities="${applicationId}.shared-media"
            android:readPermission="${applicationId}.READ_MEDIA"
            android:exported="true" android:grantUriPermissions="true" />
        <activity android:name="dev.forma.app.SharedMediaSenderActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
